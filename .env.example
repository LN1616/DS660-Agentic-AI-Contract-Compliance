# Get a key at https://aistudio.google.com/apikey then copy this file to .env
GEMINI_API_KEY=your_key_here
MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-3.6-flash
# USD per 1M tokens, used for the cost estimate in traces (check current pricing)
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# Seconds between AI calls. 4.5 keeps the free tier under ~15 requests/min; use 0 with a paid key
MIN_CALL_GAP=4.5

# Fallback model when MODEL keeps failing (overload, outage). Leave empty to turn off
FALLBACK_MODEL=gemini-3.6-flash

# Release = V5 harness. Measured extras, off by default (1 = on): see README "Release"
V6_TOOLS=0
CROSS_CHECK=0
V7_MISSING_PROMPT=0
