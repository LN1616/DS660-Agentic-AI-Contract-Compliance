# Get a key at https://aistudio.google.com/apikey then copy this file to .env
GEMINI_API_KEY=your_key_here
MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-3.6-flash
# USD per 1M tokens, used for the cost estimate in traces (check current pricing)
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# Seconds between AI calls. 4.5 keeps the free tier under ~15 requests/min; use 0 with a paid key
MIN_CALL_GAP=4.5
